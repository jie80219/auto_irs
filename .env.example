# ===== 身分資料 =====
# 取票人身分證字號（必填）
THSR_ID=A123456789
# 高鐵會員（TGo）身分證字號；留空表示以非會員訂票
THSR_MEMBER_ID=A123456789
# 選填：手機、Email（訂位成功時高鐵會寄通知）
THSR_PHONE=
THSR_EMAIL=

# ===== 行程 =====
# 站名：南港 台北 板橋 桃園 新竹 苗栗 台中 彰化 雲林 嘉義 台南 左營
FROM_STATION=台北
TO_STATION=左營
# 日期 YYYY/MM/DD
TRAVEL_DATE=2026/10/10
# 出發時間區間 HH:MM，會選區間內「最早出發」的班次
DEPART_AFTER=08:00
DEPART_BEFORE=12:00

# ===== 車廂與座位 =====
# standard=標準車廂  business=商務車廂
CAR_CLASS=standard
# none=無偏好  window=靠窗  aisle=走道
SEAT_PREF=none

# ===== 票種張數（總數 1~10 張）=====
TICKET_ADULT=1
TICKET_CHILD=0
TICKET_DISABLED=0
TICKET_ELDER=0
TICKET_COLLEGE=0

# ===== 執行設定 =====
# 選填：開賣時間 YYYY-MM-DD HH:MM:SS，程式會等到這個時間才開始（留空則立即開始）
START_AT=
# 沒位子 / 驗證碼錯誤時最多重試幾輪（每輪都需要你輸入一次驗證碼）
MAX_ATTEMPTS=10
# 每輪之間的等待秒數（下限 10 秒，避免對高鐵伺服器造成負擔）
RETRY_INTERVAL_SEC=15
# 等你輸入驗證碼的時間上限（秒）
CAPTCHA_TIMEOUT_SEC=180
